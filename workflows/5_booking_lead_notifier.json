{
  "name": "5. Booking & Lead Admin Handover Notifier",
  "nodes": [
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.aiResponse }}",
              "operation": "contains",
              "value2": "[NEED_ADMIN]"
            }
          ]
        }
      },
      "id": "node-detect-need-admin",
      "name": "Detect NEED_ADMIN",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $json.adminTelegramId || '8965842613' }}",
        "text": "=🔥 <b>NEW BOOKING LEAD / NEED ADMIN HANDOVER</b>\n\n👤 <b>Customer:</b> {{ $json.customerName }} (@{{ $json.username }})\n🆔 <b>Telegram ID:</b> <code>{{ $json.fromId }}</code>\n💬 <b>Pesan Terakhir:</b> {{ $json.lastMessage }}\n🤖 <b>AI Context:</b> Handover dipicu otomatis\n\n👉 <i>Silakan hubungi customer ini untuk menindaklanjuti reservasi.</i>",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "node-notify-admin",
      "name": "Send Admin Alert Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [440, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-id",
          "name": "Telegram Bot Account"
        }
      }
    }
  ],
  "connections": {
    "Detect NEED_ADMIN": {
      "main": [
        [
          {
            "node": "Send Admin Alert Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
